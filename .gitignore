# ==========================================
# Sharada Platform - Comprehensive .gitignore
# ==========================================

# --- OS & Editor Artifacts ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-workspace

# --- Dependencies ---
node_modules/
jspm_packages/
web_modules/

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
!.env.example

# --- Databases & SQLite ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
backend/*.db
enquiries.db

# --- Python & AI/ML Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
.venv/
venv/
ENV/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# --- Build Outputs & Caches ---
dist/
dist-ssr/
build/
.next/
out/
.vite/
*.local
*.tsbuildinfo
.eslintcache
.stylelintcache
.cache
.parcel-cache

# --- Logs & Runtime Data ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# --- Packaging & Integrity ---
*.tgz
.yarn-integrity

# --- Agent / AI Tool Temp Folders ---
.agents/
.system_generated/
